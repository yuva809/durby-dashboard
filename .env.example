# Database (Layer 2 — Unified Data Store)
DATABASE_URL="postgresql://user:password@localhost:5432/roof_ops_ai"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# AI providers (Layer 2.5 — Decision Engine, used from Phase 2 onward)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Redis / BullMQ (background jobs, used from Phase 2 onward)
REDIS_URL="redis://localhost:6379"

# Supabase Storage (invoice/PDF uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2.5 — backend connection
NEXT_PUBLIC_API_URL="http://localhost:4000"

# This app's own public URL — dashboard.durby.tech in production. Used for
# metadataBase and any self-referential link.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The Durby product site — durby.tech in production.
NEXT_PUBLIC_DURBY_URL="http://localhost:3002"
# The parent company site — extrahand.cc in production. Only used for the
# sidebar's "Powered by ExtraHand" outbound link.
NEXT_PUBLIC_EXTRAHAND_URL="http://localhost:3003"
# LEGACY / UNUSED — the restaurant is now resolved dynamically per signed-in
# user (GET /me -> RestaurantProvider -> useRestaurantId(), see
# src/hooks/use-restaurant-id.ts and backend/src/common/auth/me.controller.ts),
# not from a build-time env var. Safe to leave unset; nothing reads this.
NEXT_PUBLIC_DEMO_RESTAURANT_ID=
